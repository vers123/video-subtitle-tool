# Python 虚拟环境
venv/
.venv/
env/

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 临时文件
temp/
*.wav
*.tmp

# 错误日志
error.log

# 截图/调试文件
.screenshots/

# 系统文件
.DS_Store
Thumbs.db

# TRAE 临时包
.trae-html-share-packages/

# 空目录占位（视频和字幕文件夹不纳入版本控制，用户自行创建）
video/*
!video/.gitkeep
subtitles/*
!subtitles/.gitkeep
